{
  "manifest_version": 3,
  "name": "YouTube Comment Sentiment Analyzer",
  "version": "2.0",
  "description": "Analyze YouTube comments using AI sentiment analysis.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Comment Sentiment Analyzer"
  }
}